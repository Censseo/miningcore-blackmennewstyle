-- Pool Partition Script Example
-- Copy this file to createdb_shares.sql and customize for your pools

-- Replace 'mypool1', 'mypool2', etc. with your actual pool IDs from config.json
-- The pool ID in the partition definition MUST match exactly what's in your config

-- Example pool partitions
CREATE TABLE IF NOT EXISTS shares_btc PARTITION OF shares FOR VALUES IN ('btc');
CREATE TABLE IF NOT EXISTS shares_eth PARTITION OF shares FOR VALUES IN ('eth');
CREATE TABLE IF NOT EXISTS shares_xmr PARTITION OF shares FOR VALUES IN ('xmr');

-- Add indexes for better query performance on each partition
CREATE INDEX IF NOT EXISTS shares_btc_created_idx ON shares_btc (created);
CREATE INDEX IF NOT EXISTS shares_btc_miner_idx ON shares_btc (poolid, miner, created);

CREATE INDEX IF NOT EXISTS shares_eth_created_idx ON shares_eth (created);
CREATE INDEX IF NOT EXISTS shares_eth_miner_idx ON shares_eth (poolid, miner, created);

CREATE INDEX IF NOT EXISTS shares_xmr_created_idx ON shares_xmr (created);
CREATE INDEX IF NOT EXISTS shares_xmr_miner_idx ON shares_xmr (poolid, miner, created);

-- Grant permissions
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO miningcore;

